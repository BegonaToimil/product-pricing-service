{
  "info": {
    "_postman_id": "bdcc4c32-4e16-4aa3-93ca-3a93ed513f6a",
    "name": "Product Pricing Service",
    "description": "Integration checks for applicable product prices. Start the service at http://localhost:8080 before running the collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Test 1 - June 14 at 10:00 (price list 1)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/prices?applicationDate=2020-06-14T10:00:00&productId=35455&brandId=1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "prices"],
          "query": [
            {"key": "applicationDate", "value": "2020-06-14T10:00:00"},
            {"key": "productId", "value": "35455"},
            {"key": "brandId", "value": "1"}
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Returns 200 with the expected price', function () {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(body.productId).to.eql(35455);",
              "    pm.expect(body.brandId).to.eql(1);",
              "    pm.expect(body.priceList).to.eql(1);",
              "    pm.expect(body.startDate).to.eql('2020-06-14T00:00:00');",
              "    pm.expect(body.endDate).to.eql('2020-12-31T23:59:59');",
              "    pm.expect(Number(body.price)).to.eql(35.50);",
              "    pm.expect(body.currency).to.eql('EUR');",
              "});"
            ]
          }
        }
      ]
    },
